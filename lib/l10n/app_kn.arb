  "msLoansDeleteExtraBody": "ಇದರ ವಹಿವಾಟುಗಳೂ ಅಳಿಸುತ್ತವೆ, ಬಾಕಿ ಮತ್ತೆ ಹೆಚ್ಚುತ್ತದೆ.",
  "msLoansDeleteAdjTitle": "ಈ ಅಪ್‌ಡೇಟ್ ಅಳಿಸಬೇಕೇ?",
  "msLoansDeleteAdjBody": "ಬಾಕಿ ಮತ್ತೆ Kuber ಲೆಕ್ಕಕ್ಕೆ ಮರಳುತ್ತದೆ.",
  "msTxnEdited": "ಬದಲಿಸಲಾಗಿದೆ",
  "msTxnSplitHelper": "ನಿಮ್ಮ ಬ್ಯಾಂಕ್‌ಗೆ ಹೊಂದಿಸಲು ಇವುಗಳನ್ನು ಬದಲಿಸಿ. ಇವು ಯಾವಾಗಲೂ EMI ಗೆ ಸಮ.",
  "msTxnSplitErr": "ಅಸಲು ಮತ್ತು ಬಡ್ಡಿ 0 ಕ್ಕಿಂತ ಕಡಿಮೆ ಇರಲು ಸಾಧ್ಯವಿಲ್ಲ.",
  "msInfoSplitEditedTitle": "ಬದಲಿಸಿದ ವಿಭಜನೆ",
  "msInfoSplitEditedLine": "ನಿಮ್ಮ ಬ್ಯಾಂಕ್‌ಗೆ ಹೊಂದಿಸಲು ನೀವು ಈ ವಿಭಜನೆಯನ್ನು ಬದಲಿಸಿದ್ದೀರಿ. Kuber ಬಾಕಿಗೆ ನಿಮ್ಮ ಅಂಕಿಗಳನ್ನು ಬಳಸುತ್ತದೆ ಮತ್ತು ಅಲ್ಲಿಂದ ಮುಂದಿನ EMI ಗಳನ್ನು ಅಂದಾಜಿಸುತ್ತದೆ.",
  "msInfoAdjustBankLine": "ಬ್ಯಾಂಕ್ ಸ್ಟೇಟ್‌ಮೆಂಟ್‌ನಲ್ಲಿ ಬಾಕಿ Kuber ಗಿಂತ ಬೇರೆ ಇದ್ದಾಗ ಇದನ್ನು ಬಳಸಿ. Kuber ಆ ದಿನಾಂಕದಿಂದ ನಿಮ್ಮ ಅಂಕಿಯಿಂದ ಮುಂದುವರಿಯುತ್ತದೆ.",
  "msInfoAdjustInterestLine": "ಕೆಲವು ಬ್ಯಾಂಕ್‌ಗಳು ಪಾವತಿಸದ ಬಡ್ಡಿಯನ್ನು, ಉದಾ. ಮೊರಟೋರಿಯಂ ಅಥವಾ EMI ಆರಂಭಕ್ಕೂ ಮೊದಲು, ಬಾಕಿಗೆ ಸೇರಿಸುತ್ತವೆ. ಇದು ಸಾಲದ ಒಟ್ಟು ಬಡ್ಡಿಯಲ್ಲಿ ಎಣಿಕೆಯಾಗುತ್ತದೆ. ನಿಮ್ಮ ಖಾತೆಯಿಂದ ಹಣ ಹೋಗದ ಕಾರಣ ಇದು ಖರ್ಚಲ್ಲ.",
  "msInfoRemainingLine": "ಉಳಿದ ಬಡ್ಡಿ ನಿಮ್ಮ ಬಾಕಿ, ದರ ಮತ್ತು EMI ಮೇಲೆ ಅವಲಂಬಿತ, ಆದ್ದರಿಂದ Kuber ಇದನ್ನು ಲೆಕ್ಕಹಾಕುತ್ತದೆ. ಬದಲಿಗೆ ಬಾಕಿ ಅಥವಾ ದರವನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ.",
  "msLoansPastEmis": "ಹಿಂದಿನ EMI ಗಳನ್ನು ವಹಿವಾಟುಗಳಾಗಿ ಸೇರಿಸಿ",
  "msInfoPastEmisLine": "Kuber ಸಾಲ ಈಗಾಗಲೇ ನಡೆದ ಪ್ರತಿ ತಿಂಗಳಿಗೆ ಒಂದು EMI ವಹಿವಾಟನ್ನು ಅಸಲು ಮತ್ತು ಬಡ್ಡಿಯೊಂದಿಗೆ ಸೇರಿಸುತ್ತದೆ. ಯಾವುದೇ ಪಾವತಿಯಂತೆ ನಿಮ್ಮ ಖಾತೆಯ ಬ್ಯಾಲೆನ್ಸ್ ಒಟ್ಟು ಮೊತ್ತದಷ್ಟು ಕಡಿಮೆಯಾಗುತ್ತದೆ. ಹಿಂದಿನ ವಹಿವಾಟುಗಳಿಲ್ಲದೆ ಇಂದಿನಿಂದ ಆರಂಭಿಸಲು ಇದನ್ನು ಆಫ್ ಇಡಿ.",
  "msLoansPastEmisHelp": "ಮೊದಲ EMI ದಿನಾಂಕದಿಂದ ಇಂದಿನವರೆಗಿನ ಪ್ರತಿ EMI ಅನ್ನು ವಹಿವಾಟಾಗಿ ರಚಿಸುತ್ತದೆ.",
