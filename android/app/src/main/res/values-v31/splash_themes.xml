<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixed light / dark splash themes, chosen by MainActivity.syncSplashTheme()
  through SplashScreen.setSplashScreenTheme (Android 13+) so the splash follows
  Kuber's own theme setting instead of the phone's. Not generated by
  flutter_native_splash; keep the colours in step with its config in
  pubspec.yaml. The style NAMES are persisted by the system across app
  updates: never rename them.
-->
<resources>
    <style name="KuberSplashLight" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#D8E2FF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/android12splash_light</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#D8E2FF</item>
    </style>
    <style name="KuberSplashDark" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#001A42</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/android12splash_dark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#001A42</item>
    </style>
</resources>
